rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Cada usuario solo lee su propio rol. Los roles se asignan a mano desde la consola de Firebase.
    match /users/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }

    // Edificios y alarmas del plano: todos leen, solo el administrador modifica
    match /config/{doc} { allow read: if signedIn(); allow write: if isAdmin(); }

    // Heartbeat de paneles: escribe el gateway (Admin SDK)
    match /panels/{id} { allow read: if signedIn(); allow write: if false; }

    match /alarms/{id} {
      allow read: if signedIn();
      // Cualquier usuario autenticado puede registrar el despacho, nada más
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dispatchedAt', 'dispatchedBy']);
      allow create, delete: if false;
    }
  }
}
